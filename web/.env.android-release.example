# Configuration names only. No production identity, server, key or signing material is supplied.
# The Android release commands do not automatically read any .env file.
# Inject these values explicitly through your private local/CI environment.

GENIE_ANDROID_APPLICATION_ID=
GENIE_ANDROID_VERSION_CODE=
GENIE_ANDROID_VERSION_NAME=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_APP_URL=

# Only android:bundle needs these four private signing values.
# Use an absolute path to your release keystore. Never paste passwords into chat or commit them.
GENIE_ANDROID_KEYSTORE_PATH=
GENIE_ANDROID_KEYSTORE_PASSWORD=
GENIE_ANDROID_KEY_ALIAS=
GENIE_ANDROID_KEY_PASSWORD=

# The existing Android toolchain must already be available for bundle creation.
ANDROID_HOME=
JAVA_HOME=
GRADLE_USER_HOME=

# Optional: choose ONE already-installed Gradle distribution explicitly.
# Do not export these optional variables as empty strings.
# GENIE_GRADLE_EXECUTABLE=/absolute/path/to/gradle-8.14.3/bin/gradle
# GRADLE_HOME=/absolute/path/to/gradle-8.14.3
