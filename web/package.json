{
  "name": "genie-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "verify": "npm run test && npm run typecheck",
    "native:preview": "node scripts/build-native-preview.mjs",
    "native:sync": "npm run native:preview && cap sync",
    "android:check": "node scripts/android-release.mjs check",
    "android:prepare": "node scripts/android-release.mjs prepare",
    "android:bundle": "node scripts/android-release.mjs bundle",
    "android:jdk": "node scripts/prepare-local-jdk.mjs",
    "android:native-check": "node scripts/android-native-smoke.mjs",
    "test:android-release": "node --test scripts/android-release*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@fontsource/black-han-sans": "^5.2.5",
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
